{
  "name": "inteyvat-wiki",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "Inteyvat-Wiki",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Inteyvat-Wiki/wiki.git"
  },
  "bugs": {
    "url": "https://github.com/Inteyvat-Wiki/wiki/issues"
  },
  "homepage": "https://github.com/Inteyvat-Wiki/wiki#readme",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --port 4000",
    "generate": "nuxt generate",
    "typecheck": "nuxt prepare && vue-tsc --noEmit -p .nuxt/tsconfig.app.json && tsc --noEmit -p .nuxt/tsconfig.server.json && tsc --noEmit -p .nuxt/tsconfig.shared.json",
    "check": "npm run typecheck && npm run typecheck:misc && npm run typecheck:content && node scripts/check_content_io.mjs && npm run test:maps && npm run test:outfits",
    "test:misc": "node scripts/run_misc_checks.mjs",
    "test:maps": "node scripts/check_map_catalogue.mjs",
    "test:outfits": "node scripts/check_outfits.mjs",
    "typecheck:misc": "vue-tsc --noEmit -p scripts/tsconfig.misc.json",
    "typecheck:content": "vue-tsc --noEmit -p scripts/tsconfig.content.json",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@inteyvat-wiki/wiki-contracts": "file:../Inteyvat-Wiki-contracts",
    "@element-plus/nuxt": "^1.1.5",
    "@nuxtjs/i18n": "^10.4.0",
    "@nuxtjs/leaflet": "^1.3.2",
    "@types/node": "^25.9.2",
    "nuxt": "^4.4.8",
    "nuxt-svgo": "^5.3.0",
    "vue": "^3.5.28",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vue-tsc": "^3.3.11"
  }
}
